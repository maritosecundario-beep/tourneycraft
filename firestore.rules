rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInWithGoogle() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function validCommunityItem(data) {
      return data.keys().hasAll([
          'ownerId', 'authorName', 'type', 'title', 'payloadJson', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'authorName', 'type', 'title', 'payloadJson', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
        data.authorName is string && data.authorName.size() <= 80 &&
        data.type in ['profile', 'team', 'player', 'tournament'] &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
        data.payloadJson is string && data.payloadJson.size() > 0 && data.payloadJson.size() <= 850000 &&
        data.createdAt is string && data.updatedAt is string;
    }

    /**
     * Acceso total recursivo para el dueño del UID.
     * Permite gestionar backups, configuraciones y cualquier subcolección.
     */
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /communityItems/{itemId} {
      allow read: if true;
      allow create: if signedInWithGoogle() &&
        validCommunityItem(request.resource.data) &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if signedInWithGoogle() &&
        resource.data.ownerId == request.auth.uid &&
        validCommunityItem(request.resource.data) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedInWithGoogle() && resource.data.ownerId == request.auth.uid;
    }
    
    // Bloqueo por defecto para el resto de la base de datos
    match /{document=**} {
      allow read, write: if false;
    }
  }
}